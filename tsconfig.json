{
  "//": "Strict type check over the JavaScript (nosv1/nosv1 CODING.md rule 10). The page's scripts share one global scope.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "skipLibCheck": true,
    "target": "es2022",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": []
  },
  "include": [
    "app.js",
    "words.js",
    "defs.js",
    "sync.js",
    "draw.js",
    "test/smoke.js",
    "test/shot.js",
    "worker/src/**/*.js"
  ]
}
